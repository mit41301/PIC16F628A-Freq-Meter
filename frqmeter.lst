                      00019 
                      00020 ;**************************************************************************
                      00021 ;                                                                         *
                      00022 ; Summary                                                                 *
                      00023 ;                                                                         *
                      00024 ;**************************************************************************
                      00025 
                      00026 ; The following software functions as a frequency meter with an input signal
                      00027 ; range of 1Hz to ~ 8MHz and with an accuracy of +/- 1Hz. Supplementary pulse
                      00028 ; length and pulse count modes are also supported.
                      00029 
                      00030 ; In frequency mode, signal pulses are counted over a fixed time interval of
                      00031 ; 1/8 second or 1 second. High frequency pulses are counted over 1/8 s to make
                      00032 ; the meter more responsive with no loss of displayed accuracy.
                      00033 
                      00034 ; In pulse length mode, pulses are measured to a resolution of 1 microsecond.
                      00035 ; If this mode is selected and no pulses are present then it will lock out.
                      00036 
                      00037 ; All pulses are counted on the rising edge.
                      00038 
                      00039 ; The mode is selected by holding down the pushbutton for about a second.
                      00040 ; The modes are displayed ("FrE", "PulS", "Cntr") and cycled through.
                      00041 
                      00042 ; Pressing and immediately releasing the pushbutton clears the display and
                      00043 ; also resets the count in pulse count mode.
MPASM  5.51                      FRQMETER.ASM   6-11-2026  14:37:29         PAGE  2


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00044 
                      00045 ; The display shows the signal frequency in kHz or pulse length in ms,
                      00046 ; according to the following table:
                      00047 
                      00048 ; ----------------------------------
                      00049 ; | Frequency | Pulse    | Display |
                      00050 ; ----------------------------------
                      00051 ; | < 1Hz     | < 1us    |       0 |
                      00052 ; | 1Hz       | 1us      |   0.001 |
                      00053 ; | 10Hz      | 10us     |   0.010 |
                      00054 ; | 100Hz     | 100us    |   0.100 |
                      00055 ; | 1.000kHz  | 1.000ms  |   1.000 |
                      00056 ; | 10.00kHz  | 10.00ms  |   10.00 |
                      00057 ; | 100.0kHz  | 100.0ms  |   100.0 |
                      00058 ; | 1.000MHz  | 1.000s   |   1000. |
                      00059 ; | > ~ 8MHz  | > ~ 8s   |       E |
                      00060 ; ----------------------------------
                      00061 
                      00062 ; Underflows (frequencies less than 1Hz or pulse lengths less than 1us) or no
                      00063 ; signal at all are displayed as a single zero, and overflows (frequencies
                      00064 ; greater than ~ 8MHz or pulse lengths greater than ~ 8s) are displayed as
                      00065 ; the letter 'E' (for error).
                      00066 
                      00067 ; In pulse count mode, if the count exceeds 9999 then it wraps and keeps
                      00068 ; counting but all the decimal points are set.
                      00069 
                      00070 
                      00071 ;**************************************************************************
                      00072 ;                                                                         *
                      00073 ; Port assignments                                                        *
                      00074 ;                                                                         *
                      00075 ;**************************************************************************
                      00076 
  000000F0            00077 PORTA_IO       equ  b'11110000'    ; port A I/O status
  00000000            00078 PORTB_IO       equ  b'00000000'    ; port B I/O status
  00000001            00079 PORTB_IN       equ  b'00000001'
                      00080 
  00000006            00081 LEDS_PORT      equ  PORTB          ; 7-segment LEDs port
  00000005            00082 ENABLE_PORT    equ  PORTA          ; display enable port (low 4 bits)
                      00083 
  00000001            00084 DISPLAY0       equ  1              ; display #0 bit (0 = on)
  00000000            00085 DISPLAY1       equ  0              ; display #1 bit (0 = on)
  00000003            00086 DISPLAY2       equ  3              ; display #2 bit (0 = on)
  00000002            00087 DISPLAY3       equ  2              ; display #3 bit (0 = on)
                      00088 
  00000000            00089 BUTTON         equ  0              ; pushbutton
                      00090 
                      00091 #define   RTCC      PORTA,4
                      00092 
                      00093 
