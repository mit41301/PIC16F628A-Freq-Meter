                      00097 ;                                                                         *
                      00098 ;**************************************************************************
                      00099 
                      00100 ; processor clock frequency in Hz
  01312D00            00101 CLOCK     equ  d'20000000'
                      00102 
                      00103 ; microseconds per timing loop
  00000014            00104 TIME      equ  d'20'
                      00105 
                      00106 ; clock cycles per timing loop
  00000190            00107 CYCLES    equ  TIME*CLOCK/d'1000000'
                      00108 
                      00109 ; pushbutton poll frequency in Hz
  00000032            00110 POLL      equ  d'50'
                      00111 
                      00112 
                      00113 ;**************************************************************************
                      00114 ;                                                                         *
                      00115 ; File register usage                                                     *
                      00116 ;                                                                         *
                      00117 ;**************************************************************************
                      00118 
                      00119      cblock h'20'
                      00120 
  00000020            00121      mode                     ; mode (0 = frequency, 1 = pulse, 2 = count)
  00000021            00122      wrapped                  ; non-zero if pulse count wrapped
                      00123 
  00000022            00124      tens_index               ; index into the powers-of-ten table
  00000023            00125      divi:3                   ; power of ten (24 bits)
                      00126 
  00000026            00127      TMR0_                    ; previous RTCC
                      00128 
  00000027            00129      counter:2                ; 16-bit counter (msb first)
  00000029            00130      delay                    ; delay loop counter
  0000002A            00131      repeat                   ; repeat counter
                      00132 
  0000002B            00133      reading:3                ; reading in binary (24 bits)
  0000002E            00134      digits:7                 ; reading as decimal digits (7 bytes)
  00000035            00135      pulses:2                 ; pulse count
                      00136 
  00000037            00137      disp_timer               ; display multiplexing timer (5 bits)
  00000038            00138      disp_mask                ; display multiplexing mask
                      00139 
  00000039            00140      char                     ; display character
  0000003A            00141      work                     ; temporary register
                      00142 
                      00143      endc
                      00144 
                      00145      cblock h'40'             ; 8-byte boundary (2 address bits + 1 guard bit)
                      00146 
  00000040            00147      displays:4               ; display data
                      00148 
                      00149      endc
