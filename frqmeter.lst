                      00152 ;**************************************************************************
                      00153 ;                                                                         *
                      00154 ; Macros                                                                  *
                      00155 ;                                                                         *
                      00156 ;**************************************************************************
                      00157 
                      00158 routine   macro label              ; routine
                      00159 label
                      00160           endm
                      00161 
                      00162 table     macro label              ; define lookup table
                      00163 label     addwf PCL
                      00164           endm
                      00165 
                      00166 entry     macro value              ; define table entry
                      00167           retlw value
                      00168           endm
                      00169 
                      00170 index     macro label              ; index lookup table
                      00171           call label
                      00172           endm
                      00173 
                      00174 jump      macro label              ; jump through table
                      00175           goto label
                      00176           endm
                      00177 
                      00178 tstw      macro                    ; test w register
                      00179           iorlw 0
                      00180           endm
                      00181 
                      00182 movff     macro f1,f2              ; move file to file
                      00183           movfw f1
                      00184           movwf f2
                      00185           endm
                      00186 
                      00187 movlf     macro n,f                ; move literal to file
                      00188           movlw n
                      00189           movwf f
                      00190           endm
                      00191 
                      00192 tris_A    macro                    ; tristate port A
                      00193           bsf STATUS,RP0
                      00194           movwf TRISA&h'7f'
                      00195           bcf STATUS,RP0
                      00196           endm
                      00197 
                      00198 tris_B    macro                    ; tristate port B
                      00199           bsf STATUS,RP0
                      00200           movwf TRISB&h'7f'
                      00201           bcf STATUS,RP0
                      00202           endm
