                      00203 
                      00204 option_   macro                    ; set options
                      00205           bsf STATUS,RP0
                      00206           movwf OPTION_REG&h'7f'
                      00207           bcf STATUS,RP0
                      00208           endm
                      00209 
                      00210 
                      00211 ;--------------------------------------------------------------------------
                      00212 ; add with carry - adds the w register and the carry flag to the file
                      00213 ; register f, returns the result in f with the carry flag set if overflow
                      00214 ;--------------------------------------------------------------------------
                      00215 
                      00216 addcwf    macro f
                      00217 
                      00218           local add1,add2
                      00219 
                      00220           bnc add1                      ; branch if no carry set
                      00221 
                      00222           addwf f                       ; add byte
                      00223 
                      00224           incf f                        ; add carry
                      00225           skpnz
                      00226           setc
                      00227 
                      00228           goto add2
                      00229 
                      00230 add1      addwf f                       ; add byte
                      00231 
                      00232 add2
                      00233           endm
                      00234 
                      00235 
                      00236 ;--------------------------------------------------------------------------
                      00237 ; subtract with no carry - subtracts the w register and the no carry flag
                      00238 ; from the file register f, returns the result in f with the no carry flag
                      00239 ; set if underflow
                      00240 ;--------------------------------------------------------------------------
                      00241 
                      00242 subncwf   macro f
                      00243 
                      00244           local sub1,sub2
                      00245 
                      00246           bc sub1                       ; branch if carry set
                      00247 
                      00248           subwf f                       ; subtract byte
                      00249 
                      00250           skpnz                         ; subtract no carry
                      00251           clrc
                      00252           decf f
                      00253 
                      00254           goto sub2
                      00255 
MPASM  5.51                      FRQMETER.ASM   6-11-2026  14:37:29         PAGE  6


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00256 sub1      subwf f                       ; subtract byte
                      00257 
                      00258 sub2
                      00259           endm
                      00260 
                      00261 
                      00262 ;--------------------------------------------------------------------------
                      00263 ; 24-bit addition - adds the three bytes at op2 to the three bytes at
                      00264 ; op1 (most significant bytes first), returns the result in op1 with
                      00265 ; op2 unchanged and the carry flag set if overflow
                      00266 ;--------------------------------------------------------------------------
                      00267 
                      00268 add24     macro op1,op2                 ; op1 <= op1 + op2
                      00269 
                      00270           movfw op2+2                   ; add low byte
                      00271           addwf op1+2
                      00272 
                      00273           movfw op2+1                   ; add middle byte
                      00274           addcwf op1+1
                      00275 
                      00276           movfw op2+0                   ; add high byte
                      00277           addcwf op1+0
                      00278 
                      00279           endm
                      00280 
                      00281 
                      00282 ;--------------------------------------------------------------------------
                      00283 ; 24-bit subtraction - subtracts the three bytes at op2 from the three
                      00284 ; bytes at op1 (most significant bytes first), returns the result in op1
                      00285 ; with op2 unchanged and the no carry flag set if underflow
                      00286 ;--------------------------------------------------------------------------
                      00287 
                      00288 sub24     macro op1,op2                 ; op1 <= op1 - op2
                      00289 
                      00290           movfw op2+2                   ; subtract low byte
                      00291           subwf op1+2
                      00292 
                      00293           movfw op2+1                   ; subtract middle byte
                      00294           subncwf op1+1
                      00295 
                      00296           movfw op2+0                   ; subtract high byte
                      00297           subncwf op1+0
                      00298 
                      00299           endm
                      00300 
                      00301 
                      00302 ;--------------------------------------------------------------------------
                      00303 ; reset vector
                      00304 ;--------------------------------------------------------------------------
                      00305 
0000                  00306           org 0
                      00307 
0000   29D1           00308           goto main_entry
